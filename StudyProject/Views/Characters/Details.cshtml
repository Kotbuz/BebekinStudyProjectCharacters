@model StudyProject.Models.CharacterModel

@{
    ViewData["Title"] = Model.Name ?? "Character Details";
}

<h1>@ViewData["Title"]</h1>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Species:</strong> @Model.Species</p>
<p><strong>Level:</strong> @Model.Level</p>
<p><strong>Description:</strong> @Model.Description</p>

<p><a asp-action="Index">Back to List</a></p>
